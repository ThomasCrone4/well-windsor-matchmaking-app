# Copy to .env.local and fill in. .env.local is gitignored.
#
# Both of these are PUBLIC values that ship in the client bundle.
# Row-level security is what protects the data behind the anon key.
#
# Never add a privileged secret here. Anything prefixed VITE_ is inlined
# into the JavaScript that every visitor downloads. Service-role keys,
# email provider keys and the like belong in Supabase Edge Function
# secrets, never in this file.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ---------------------------------------------------------------------------
# NOT HERE: Edge Function secrets.
#
# These are read by the Supabase Edge Functions on Supabase's servers, so they
# go in Supabase (Dashboard -> Edge Functions -> Secrets, or
# `supabase secrets set NAME=value`). Putting them in this file, or in
# Cloudflare Pages, does nothing — neither reaches an Edge Function.
#
#   BREVO_KEY            Brevo API key                    (required)
#   BREVO_SENDER_EMAIL   verified sender address in Brevo (required; email
#                        refuses to send without it)
#   BREVO_SENDER_NAME    defaults to "Well Windsor"
#   EMAIL_REPLY_TO       defaults to hello@wellwindsor.org.uk
#   EMAIL_PRIVACY_URL    set to <site>/privacy
#   EMAIL_LOGO_URL       absolute URL of the logo, once hosted
#   APP_URL              the site's origin, so outreach emails link to roles
# ---------------------------------------------------------------------------

# Base URL used to build the password-reset redirect. Falls back to
# window.location.origin when unset, which is fine for local dev.
# VITE_PUBLIC_APP_URL=https://volunteer.wellwindsor.org.uk
