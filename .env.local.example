# Copy to .env.local and fill in. .env.local is gitignored.
#
# Both of these are PUBLIC values that ship in the client bundle.
# Row-level security is what protects the data behind the anon key.
#
# Never add a privileged secret here. Anything prefixed VITE_ is inlined
# into the JavaScript that every visitor downloads. Service-role keys,
# email provider keys and the like belong in Supabase Edge Function
# secrets, never in this file.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Base URL used to build the password-reset redirect. Falls back to
# window.location.origin when unset, which is fine for local dev.
# VITE_PUBLIC_APP_URL=https://volunteer.wellwindsor.org.uk
